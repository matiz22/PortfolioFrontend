{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "projects": {
    "PortfolioFrontend": {
      "projectType": "application",
      "i18n": {
        "sourceLocale": "en",
        "locales": {
          "pl": {
            "translation": "src/locale/pl.json",
            "subPath": ""
          }
        }
      },
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "localize": true,
            "security": {
              "allowedHosts": [
                "malich.dev",
                "localhost",
                "127.0.0.1",
                "[::1]"
              ]
            },
            "browser": "src/main.ts",
            "polyfills": [
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/geist/index.css",
              "node_modules/@fontsource/geist-pixel/index.css",
              "src/styles.scss",
              "src/animations.scss",
              {
                "input": "node_modules/blobatar/dist/motion.css",
                "bundleName": "blobatar-motion",
                "inject": false
              },
              {
                "input": "node_modules/blobatar/dist/gaze.css",
                "bundleName": "blobatar-motion",
                "inject": false
              }
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "pl": {
              "localize": [
                "pl"
              ]
            },
            "production": {
              "optimization": {
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                }
              },
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "hidden": true
              },
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "505kB",
                  "maximumError": "512kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "5kB",
                  "maximumError": "8kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "hmr": false
          },
          "configurations": {
            "production": {
              "buildTarget": "PortfolioFrontend:build:production"
            },
            "development": {
              "buildTarget": "PortfolioFrontend:build:development"
            },
            "local": {
              "buildTarget": "PortfolioFrontend:build:local"
            },
            "pl": {
              "buildTarget": "PortfolioFrontend:build:local,pl"
            }
          },
          "defaultConfiguration": "local"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "PortfolioFrontend:build",
            "format": "json",
            "outputPath": "src/locale"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss",
              "src/animations.scss"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  }
}
